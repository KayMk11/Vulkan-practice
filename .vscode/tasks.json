        {
            "label": "Build Active Vulkan Step",
            "type": "shell",
            "command": "make",
            "args": [
                "DIR=${relativeFileDirname}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Active Vulkan Step",
            "type": "shell",
            "command": "make",
            "args": [
                "run",
                "DIR=${relativeFileDirname}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
    ]
}