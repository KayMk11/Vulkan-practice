{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Active Vulkan Step",
            "type": "cppdbg",
            "request": "launch",
            // Points to the binary inside the active folder matching our Makefile
            "program": "${workspaceFolder}/${relativeFileDirname}/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/${relativeFileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod download inside this session",
                    "text": "set debuginfod enable off",
                    "ignoreFailures": true
                },
                // {
                // "description": "Ignore SIGTRAP signals from background worker threads",
                // "text": "handle SIGTRAP nostop noprint pass",
                // "ignoreFailures": true
                // }
            ],
            "preLaunchTask": "Build Active Vulkan Step",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}